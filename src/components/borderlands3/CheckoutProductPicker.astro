---
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { RadioGroup, RadioGroupItem } from '@/components/starwind/radio-group';
import { BL3_CHECKOUT, CLOUD_DMA_CHECKOUT, HWID_SPOOFER_CHECKOUT } from '../../data/borderlands3Site';
import { formatPlanPrice, getProductPlans } from '../../data/productPricing';

export type CheckoutProductId = 'borderlands-3' | 'cloud-dma' | 'hwid-spoofer';

interface Props {
  defaultProduct?: CheckoutProductId;
  class?: string;
}

const { defaultProduct = 'borderlands-3', class: className } = Astro.props;

const bl3From = getProductPlans('borderlands-3')[0]!.priceUsd;
const cloudPrice = getProductPlans('cloud-dma')[0]!.priceUsd;
const hwidPrice = getProductPlans('hwid-spoofer')[0]!.priceUsd;

const products: {
  id: CheckoutProductId;
  label: string;
  detail: string;
  price: string;
  href: string;
}[] = [
  {
    id: 'borderlands-3',
    label: 'Primary product cheats',
    detail: 'Main plan — soft aim, ESP, radar',
    price: `From ${formatPlanPrice(bl3From)}`,
    href: BL3_CHECKOUT,
  },
  {
    id: 'hwid-spoofer',
    label: 'HWID Spoofer',
    detail: 'Hardware ID reset utility',
    price: formatPlanPrice(hwidPrice),
    href: HWID_SPOOFER_CHECKOUT,
  },
  {
    id: 'cloud-dma',
    label: 'Cloud DMA license',
    detail: 'Hyper-V infrastructure layer',
    price: formatPlanPrice(cloudPrice),
    href: CLOUD_DMA_CHECKOUT,
  },
];

const initial = products.find((p) => p.id === defaultProduct) ?? products[0]!;
---

<aside
  class:list={['text-left lg:sticky lg:top-28', className]}
  data-checkout-product-picker
  aria-labelledby="checkout-product-picker-title"
>
  <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-start gap-3 border-b border-border bg-muted/30 px-5 py-4 text-left">
      <div class="min-w-0 text-left">
        <p class="text-sm font-medium text-muted-foreground">Purchase</p>
        <h2 id="checkout-product-picker-title" class="text-base font-semibold leading-snug text-foreground">
          Choose a product
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-5">
      <RadioGroup
        defaultValue={initial.id}
        name="checkout-product"
        legend="Select product"
        class="flex flex-col gap-2"
      >
        {
          products.map((product) => (
            <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-border bg-background p-3.5 transition-colors has-data-checked:border-primary has-data-checked:bg-primary/10">
              <span class="flex min-w-0 items-start gap-3">
                <RadioGroupItem value={product.id} variant="primary" class="mt-0.5" />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-foreground">{product.label}</span>
                  <span class="block text-xs text-muted-foreground">{product.detail}</span>
                </span>
              </span>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-foreground">{product.price}</span>
            </label>
          ))
        }
      </RadioGroup>

      <Button
        as="a"
        href={initial.href}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
        data-checkout-product-continue
      >
        Continue to checkout
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</aside>

<script define:vars={{ products }}>
  const initCheckoutProductPicker = () => {
    document.querySelectorAll('[data-checkout-product-picker]').forEach((root) => {
      if (root.hasAttribute('data-picker-bound')) return;
      root.setAttribute('data-picker-bound', '');

      const group = root.querySelector('[data-sw-radio-group]');
      const continueBtn = root.querySelector('[data-checkout-product-continue]');
      if (!group || !continueBtn) return;

      const sync = () => {
        const id = group.getAttribute('data-value');
        const product = products.find((p) => p.id === id) ?? products[0];
        if (product) continueBtn.href = product.href;
      };

      group.addEventListener('click', () => window.setTimeout(sync, 0));
      const observer = new MutationObserver(sync);
      observer.observe(group, { attributes: true, attributeFilter: ['data-value'] });
      sync();
    });
  };

  initCheckoutProductPicker();
  document.addEventListener('astro:after-swap', initCheckoutProductPicker);
</script>
