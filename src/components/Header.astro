---
import { t } from '../i18n';
import { PRIMARY_CHECKOUT_PATH } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import { sheetTitle } from '@/components/starwind/sheet/variants';

import type { IconName } from './icons/types';

const navIcons: Record<string, IconName> = {
  '/#features': 'navFeatures',
  '/#products': 'navProducts',
  '/caliber-cheats-price/': 'navProducts',
  '/pricing/': 'navProducts',
  '/caliber-esp/': 'navFeatures',
  '/caliber-aimbot/': 'navFeatures',
  '/caliber-cheats-review/': 'navBlog',
  '/guides/caliber-sard-anti-cheat/': 'reqSettings',
  '/cloud-dma/': 'reqCpu',
  '/hwid-spoofer/': 'shieldCheck',
  '/faq/': 'navFaq',
  '/guides/cloud-dma-setup/': 'navBlog',
  '/guides/borderlands-3-cheat-system-requirements/': 'reqSettings',
  '/support/': 'navSupport',
};

const purchaseUrl = PRIMARY_CHECKOUT_PATH;
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto flex h-14 w-full max-w-6xl items-center justify-between gap-3 rounded-xl border border-border bg-card/95 px-4 text-foreground shadow-sm sm:px-5 xl:grid xl:h-[4.25rem] xl:max-w-[84rem] xl:grid-cols-[auto_minmax(0,1fr)_auto] xl:items-center xl:gap-4 xl:px-6"
    >
    <a href="/" class="inline-flex min-w-0 max-w-[46%] shrink-0 items-center gap-2 font-[family-name:var(--font-heading)] text-base font-semibold tracking-tight sm:max-w-none xl:justify-self-start xl:text-lg" aria-label={t.ui.homeAria}>
      <img src="/apple-touch-icon.png" alt="" width="32" height="32" class="size-8 shrink-0 rounded-md" />
      <span class="truncate" aria-hidden="true">Caliber <span class="text-muted-foreground">Cheats</span></span>
      <span class="sr-only"> site header</span>
    </a>

    <nav
      class="hidden min-w-0 justify-self-center xl:flex xl:flex-nowrap xl:items-center xl:justify-center xl:gap-1"
      aria-label="Primary"
    >
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-lg px-2.5 py-2 text-sm font-medium leading-none text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIcons[link.href] ?? 'navFeatures'} size={16} class="shrink-0 opacity-90" />
          {link.label}
          <span class="sr-only"> primary nav</span>
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2 xl:justify-self-end">
      <div class="hidden items-center xl:flex">
        <Button as="a" href={purchaseUrl} variant="primary" size="sm" class="shrink-0 rounded-lg" aria-label={t.ui.checkoutAria}>
          {t.ui.browseCheats}
        </Button>
      </div>

      <Sheet class="xl:hidden">
        <SheetTrigger
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted xl:hidden"
          aria-label={t.ui.menuOpen}
        >
          <Icon name="menu" size={20} />
        </SheetTrigger>
        <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
          <SheetHeader>
            <p class={sheetTitle()}>{t.site.name}</p>
          </SheetHeader>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={link.href}
                class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIcons[link.href] ?? 'navFeatures'} size={16} />
                {link.label}
                <span class="sr-only"> mobile menu</span>
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
            {t.ui.browseCheatsMobile}
          </Button>
        </SheetContent>
      </Sheet>
    </div>
    </div>
  </div>
</header>
