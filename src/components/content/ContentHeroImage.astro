---
import {
  defaultWebpSrc,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
  responsiveSrcSet,
} from '../../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, priority = false, class: className = '' } = Astro.props;
const isRaster = /\.(png|jpe?g|webp)$/i.test(src);
const srcSet = isRaster ? responsiveSrcSet(src, HERO_IMAGE_WIDTHS) : undefined;
const imgSrc = isRaster ? defaultWebpSrc(src, HERO_IMAGE_WIDTHS) : src;
---

<figure class={`overflow-hidden rounded-2xl border border-border bg-muted/20 ${className}`}>
  <img
    src={imgSrc}
    srcset={srcSet}
    sizes={isRaster ? HERO_IMAGE_SIZES : undefined}
    alt={alt}
    width={960}
    height={540}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="aspect-video w-full object-cover"
  />
  <figcaption class="border-t border-border px-4 py-2 text-xs text-muted-foreground">{alt}</figcaption>
</figure>
