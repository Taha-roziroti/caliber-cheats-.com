---
import HeroSection from './HeroSection.astro';
import FeaturesSection from './FeaturesSection.astro';
import ProductsSection from './ProductsSection.astro';
import WhySetupSection from './WhySetupSection.astro';
import WorkflowSection from './WorkflowSection.astro';
import HomeGuidesSection from './HomeGuidesSection.astro';
import SiteFaqSection from './SiteFaqSection.astro';
import CaliberPageArticle from './content/CaliberPageArticle.astro';
import { getCaliberPage } from '../content/caliber-pages';
import { faqsFromCaliberPage } from '../utils/caliberPageFaq';

const homePage = getCaliberPage('/')!;
const homeFaqs = faqsFromCaliberPage(homePage, 'home');
---

<HeroSection />
<div class="below-fold-section">
  <FeaturesSection />
</div>
<div class="below-fold-section">
  <ProductsSection />
</div>
<div class="below-fold-section">
  <WhySetupSection />
</div>
<div class="below-fold-section">
  <WorkflowSection />
</div>
<div class="below-fold-section">
  <HomeGuidesSection />
</div>
<section class="below-fold-section border-y border-border bg-muted/15 py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <CaliberPageArticle page={homePage} skipH1 />
  </div>
</section>
<SiteFaqSection
  id="faq"
  titleId="faq-title"
  titleAs="h2"
  items={homeFaqs}
  eyebrow="FAQ"
  title="Caliber cheats questions"
  subtitle="Answers tied to the listed product features, plans, and setup requirements."
  showFilters={false}
/>
