---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import { getCaliberPage } from '../content/caliber-pages';
import { CALIBER_PAGE_SHELL } from '../content/caliber-page-shell';
import { jsonLdForContentPage } from '../utils/contentPageJsonLd';
import { CALIBER_IMAGE } from '../data/caliberMedia';
import { defaultWebpSrc, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';

const page = getCaliberPage('/')!;
const heroLcp = defaultWebpSrc(CALIBER_IMAGE.heroBanner, HERO_IMAGE_WIDTHS);
const shell = CALIBER_PAGE_SHELL['/']!;
const jsonLd = jsonLdForContentPage({
  route: '/',
  seoTitle: page.seoTitle,
  metaDescription: page.metaDescription,
  schemaTypes: shell.schemaTypes,
});
---

<BaseLayout
  title={page.seoTitle}
  description={page.metaDescription}
  jsonLd={jsonLd}
  ogImageAlt={page.imageAltText[0]}
  logoAlt="Caliber Cheats — logo"
>
  <link slot="head" rel="preload" as="image" href={heroLcp} type="image/webp" fetchpriority="high" />
  <HomeLanding />
</BaseLayout>
