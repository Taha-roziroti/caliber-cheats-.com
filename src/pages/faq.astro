---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Caliber Cheats FAQ — logo"
  jsonLd={[
    webPageSchema({
      name: 'FAQ — plans, Cloud DMA & checkout',
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-title"
    titleAs="h1"
    eyebrow="Help center"
    title="FAQ: cheat plans, Cloud DMA pricing & checkout help"
    subtitle="Filter answers on pricing, Cloud DMA, Windows requirements, and checkout—or open a question below."
    class="border-b border-border bg-muted/10"
  />
</BaseLayout>
