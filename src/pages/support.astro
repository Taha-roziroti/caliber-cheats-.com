---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Support', path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support — Caliber Cheats logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <section class="border-t border-border bg-muted/10 py-10 md:py-12">
    <div class="mx-auto max-w-3xl px-5 text-sm leading-relaxed text-muted-foreground">
      <p class="text-lg font-semibold text-foreground">Before you contact support</p>
      <p class="mt-3">
        Confirm the listed offers match your order: Primary product cheats at $35 monthly or $150 lifetime, plus optional $50 lifetime Cloud DMA and HWID utilities on separate checkouts.
      </p>
      <p class="mt-3">
        Common answers live in the <a href="/faq/" class="text-primary underline underline-offset-2">pre-purchase FAQ</a>. Include your order email, Windows build, and any loader or Hyper-V error text when you write in.
      </p>
    </div>
  </section>
</BaseLayout>
